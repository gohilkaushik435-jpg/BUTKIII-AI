<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Butkiii ❤️ AI</title>
<style>
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #100710;
  color: white;
  text-align: center;
}
header {
  background: #ff4f91;
  padding: 20px;
  font-size: 25px;
  font-weight: bold;
}
.avatar {
  font-size: 75px;
  margin-top: 25px;
}
#chat {
  height: 45vh;
  overflow-y: auto;
  padding: 15px;
}
.message {
  background: #291725;
  padding: 12px;
  border-radius: 15px;
  margin: 10px auto;
  max-width: 80%;
  overflow-wrap: anywhere;
}
.controls {
  position: fixed;
  bottom: 15px;
  left: 5%;
  width: 90%;
}
input {
  box-sizing: border-box;
  width: 72%;
  padding: 13px;
  border-radius: 20px;
  border: none;
}
button {
  background: #ff4f91;
  color: white;
  border: none;
  border-radius: 20px;
  padding: 12px;
  margin: 4px;
}
</style>
</head>
<body>
<header>Butkiii ❤️ AI</header>
<div class="avatar">👩🏻‍💻💕</div>
<h3>Your AI Companion ❤️</h3>
<div id="chat">
  <div class="message">Hello jaan! ❤️ Hu Butkiii chu. Kem cho? 😊</div>
</div>
<div class="controls">
  <input id="msg" placeholder="Type your message...">
  <button onclick="sendMessage()">Send</button>
  <button onclick="listen()">🎤</button>
</div>
<script>
function sendMessage() {
  const input = document.getElementById('msg');
  const text = input.value.trim();
  if (!text) return;

  addMessage('You: ' + text);
  input.value = '';

  const reply = 'Hu Butkiii chu jaan ❤️ Tame shu vaat karva mango cho?';
  setTimeout(() => addMessage('Butkiii: ' + reply), 400);
}

function addMessage(text) {
  const chat = document.getElementById('chat');
  const div = document.createElement('div');
  div.className = 'message';
  div.textContent = text;
  chat.appendChild(div);
  chat.scrollTop = chat.scrollHeight;
}

function listen() {
  const Recognition = window.SpeechRecognition ||
                      window.webkitSpeechRecognition;

  if (!Recognition) {
    alert('Voice recognition mate Chrome browser try karo.');
    return;
  }

  const recognition = new Recognition();
  recognition.lang = 'gu-IN';
  recognition.onresult = event => {
    document.getElementById('msg').value =
      event.results[0][0].transcript;
  };
  recognition.start();
}
</script>
</body>
</html>